LLM_BASE_URL=http://llama-server:8080/v1
VISION_BASE_URL=http://vision-server:8081/v1
PUBLIC_HOST=llm.example.internal
TLS_CERT_FILE=fullchain.pem
TLS_KEY_FILE=llm.example.internal-key.pem
VISION_MODEL=qwen2.5-vl:3b
IMAGE_BASE_URL=http://image-server:7860
SPEACHES_BASE_URL=http://speaches:8000/v1
FILES_DIR=/data/files
AUTH_DB_PATH=/data/auth.db
API_KEY_SECRET=CHANGE_ME_API_KEY_SECRET
API_KEY_SALT=CHANGE_ME_API_KEY_SALT
CHAT_CONCURRENCY=2
EMBED_CONCURRENCY=1
QUEUE_TIMEOUT=30
TOOL_MAX_ITERATIONS=8
TOOL_ARG_MAX_LEN=50000
TOOL_OUTPUT_MAX_LEN=100000
PYTHON_TIMEOUT=30
PYTHON_CODE_MAX_LEN=12000
LLM_CHAT_TIMEOUT_SECONDS=600
DEFAULT_MODEL=qwen3:8b
TOOL_EXECUTION_MODE=client
AUTO_ENABLE_LOCAL_TOOLS=false
OPENWEBUI_ADAPTER_API_KEY=CHANGE_ME_OPENWEBUI_ADAPTER_API_KEY
OPENCODE_FORCE_TOOL_CHOICE=0
OPENCODE_FILTER_TOOLS_FOR_LOCAL_MODELS=1
OPENCODE_ENABLE_PSEUDO_TOOL_EXTRACTION=1
