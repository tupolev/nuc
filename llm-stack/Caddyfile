{$PUBLIC_HOST} {

    tls /certs/{$TLS_CERT_FILE} /certs/{$TLS_KEY_FILE}

    handle /v1/* {
        reverse_proxy adapter:4000 {
            transport http {
                versions 1.1
            }
        }
    }

    handle /metrics {
        reverse_proxy adapter:4000
    }

    handle /metrics/* {
        reverse_proxy adapter:4000
    }

    handle {
        reverse_proxy open-webui:8080
    }
}
